{
  "name": "rag-neo4j-students",
  "version": "1.0.0",
  "description": "RAG Neo4j Students",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env --import tsx src/index.ts",
    "dev": "node --watch --inspect --env-file .env --import tsx src/index.ts",
    "test": "node --env-file .env --import tsx --test tests/**/*.test.ts",
    "seed": "node --env-file .env --import tsx data/seed.ts",
    "test:dev": "node --inspect --env-file .env --import tsx --test --watch tests/**/*.test.ts",
    "test:e2e:dev": "node --inspect --env-file .env --import tsx --test --watch tests/**/*e2e.test.ts",
    "test:e2e": "node --inspect --env-file .env --import tsx --test tests/**/*e2e.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "docker:infra:up": "docker compose up -d --wait",
    "docker:infra:down": "docker compose down",
    "docker:infra:cleanup": "docker compose down --volumes --remove-orphans && rm -rf storage",
    "docker:infra:logs": "docker compose logs -f",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "article-generator",
    "openrouter",
    "ollama"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^1.1.17",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/openai": "^1.2.9",
    "fastify": "^5.7.4",
    "langchain": "^1.2.25",
    "neo4j-driver": "^5.28.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.12",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
