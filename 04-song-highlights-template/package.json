{
  "name": "song-recommender-memory",
  "version": "1.0.0",
  "description": "Song recommender with LangGraph memory persistence using LibSQL",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "start": "node --env-file .env --import tsx src/index.ts",
    "dev": "node --watch --inspect --env-file .env --import tsx src/index.ts",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:jest:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "chat:erickwendel": "node --env-file .env --import tsx src/index.ts --user erickwendel",
    "chat:ana": "node --env-file .env --import tsx src/index.ts --user ana",
    "chat:gleison": "node --env-file .env --import tsx src/index.ts --user gleison"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "memory",
    "libsql",
    "sqlite",
    "song-recommender",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.7",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.12",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.14",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@libsql/client": "^0.17.0",
    "@openrouter/sdk": "^0.8.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.10.0",
    "knex": "^3.1.0",
    "langchain": "^1.4.2"
  }
}
