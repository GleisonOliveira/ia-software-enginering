{
  "name": "multiple-mcp-tools",
  "version": "1.0.0",
  "description": "LangGraph agent that wraps SerpAPI Google Trends as a LangChain tool to answer video content strategy questions",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env --import tsx src/index.ts",
    "dev": "node --watch --inspect --env-file .env --import tsx src/index.ts",
    "test": "node --env-file .env --import tsx --test tests/**/*.test.ts",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "docker:infra:up": "docker compose up -d --wait",
    "docker:infra:down": "docker compose down",
    "docker:infra:cleanup": "docker compose down --volumes --remove-orphans && rm -rf storage",
    "docker:infra:logs": "docker compose logs -f"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.2.5",
    "csvtojson": "^2.0.14",
    "fastify": "^5.7.4",
    "langchain": "^1.2.39"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.12",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
