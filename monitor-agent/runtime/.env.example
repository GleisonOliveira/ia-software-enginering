# Provider selection: openai | anthropic | google | mistral | openrouter
LLM_PROVIDER=openrouter

# Base URL for the LLM provider (override for OpenRouter, local models, proxies, etc.)
# openai default:     https://api.openai.com/v1
# anthropic default:  https://api.anthropic.com/v1
# google default:     https://generativelanguage.googleapis.com/v1beta
# mistral default:    https://api.mistral.ai/v1
# openrouter:         https://openrouter.ai/api/v1
LLM_BASE_URL=

# Model for the selected provider
# openrouter uses "provider/model" format, e.g.: openai/gpt-4o-mini, anthropic/claude-sonnet-4
LLM_MODEL=openai/gpt-4o-mini

# Token limit for the agent execution
LLM_MAX_TOKENS=50000

# Provider-specific API keys (only configure the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
