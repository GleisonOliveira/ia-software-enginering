{
  "name": "@monitor-agent/runtime",
  "version": "1.0.0",
  "description": "AI agent execution runtime — multi-provider LLM with structured outputs",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "monitor-runtime": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit --project tsconfig.test.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.5.0",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.25.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  }
}
