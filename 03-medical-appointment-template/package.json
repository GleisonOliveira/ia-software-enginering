{
  "name": "prompt-chaining-article-generator",
  "version": "1.0.0",
  "description": "Technical article generator using LangChain prompt chaining with reusable templates",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env --import tsx src/index.ts",
    "dev": "node --watch --inspect --env-file .env --import tsx src/index.ts",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:jest:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "langgraph:serve": "npx @langchain/langgraph-cli dev"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "article-generator",
    "openrouter",
    "ollama"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.2.5",
    "@openrouter/sdk": "^0.5.1",
    "fastify": "^5.7.4",
    "langchain": "^1.4.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.12",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
